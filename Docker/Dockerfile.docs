# Lightweight container for building/previewing the MkDocs documentation site.
# Usage: docker compose -f Docker/docker-compose.yml up docs

FROM python:3.12-slim

WORKDIR /site

RUN pip install --no-cache-dir mkdocs-material mkdocs-mermaid2-plugin

# mkdocs.yml + Docs/ are bind-mounted at runtime via docker-compose.yml
EXPOSE 8000

CMD ["mkdocs", "serve", "--dev-addr=0.0.0.0:8000"]
